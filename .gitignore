$null
_release_errors.log

# --- База данных (создаётся при запуске) ---
court_case_app/database/*.db
court_case_app/database/*.db-wal
court_case_app/database/*.db-shm

# --- Временные папки приложения ---
court_case_app/uploads/*
court_case_app/output/*
!court_case_app/uploads/.gitkeep
!court_case_app/output/.gitkeep

# --- Личные файлы пользователя ---
/2020 гр.xlsx
/АКТ уничтожения гражданских дел 9СУ 2020.xlsm

# --- Офисные документы: исключаем везде, кроме важных мест ---
*.xlsx
*.xlsm
*.xls
*.docm
*.docx

# Исключения: шаблон акта и релизы
!court_case_app/docs/*.docx
!Releases/**/*.docx
!Releases/**/*.xlsx

